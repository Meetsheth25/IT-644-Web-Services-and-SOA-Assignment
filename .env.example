# ==============================================================================
# LAB 7: CAMPUSCONNECT ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for Docker Compose or local execution:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real secrets or credentials to version control.
# - Local Docker uses container service names (user-service, etc.).
# - Cloud deployment (Render) replaces these with live cloud URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. API GATEWAY (Port 3000 - Single Public Entry Point)
# ------------------------------------------------------------------------------
PORT=3000
GATEWAY_PORT=3000
CORS_ORIGIN=*

# Placeholder for Cloud Gateway Testing (e.g. Render public URL):
# GATEWAY_URL=https://YOUR-GATEWAY-SERVICE.onrender.com

# ------------------------------------------------------------------------------
# 1. USER SERVICE (Port 3001)
# ------------------------------------------------------------------------------
USER_SERVICE_PORT=3001
USER_MONGODB_URI=mongodb://mongodb:27017/user_db
# For MongoDB Atlas (replace placeholders):
# USER_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/user_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. PRODUCT SERVICE (Port 3002)
# ------------------------------------------------------------------------------
PRODUCT_SERVICE_PORT=3002
PRODUCT_MONGODB_URI=mongodb://mongodb:27017/product_db
# For MongoDB Atlas (replace placeholders):
# PRODUCT_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/product_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. ORDER SERVICE (Port 3003)
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=3003
ORDER_MONGODB_URI=mongodb://mongodb:27017/order_db
# For MongoDB Atlas (replace placeholders):
# ORDER_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/order_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. SERVICE DISCOVERY / INTER-SERVICE REST URLS
# ------------------------------------------------------------------------------
# Inside Docker Compose (campus-network internal DNS):
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# For Local Execution on Host (outside Docker):
# USER_SERVICE_URL=http://localhost:3001
# PRODUCT_SERVICE_URL=http://localhost:3002
# ORDER_SERVICE_URL=http://localhost:3003

# For Cloud Deployment (Render PaaS):
# USER_SERVICE_URL=https://YOUR-USER-SERVICE.onrender.com
# PRODUCT_SERVICE_URL=https://YOUR-PRODUCT-SERVICE.onrender.com
# ORDER_SERVICE_URL=https://YOUR-ORDER-SERVICE.onrender.com
