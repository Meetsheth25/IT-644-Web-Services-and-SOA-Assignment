# ==============================================================================
# LAB 9: AI SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure in root .env:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

PORT=3004
AI_SERVICE_PORT=3004
CORS_ORIGIN=*

# Hosted Generative AI Provider Settings
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Hosted Provider Secret API Key (Required for live generation)
# Obtain from https://aistudio.google.com/app/apikey
AI_API_KEY=replace_with_your_gemini_api_key

# Operational Safeguards
AI_TIMEOUT_MS=240000
MAX_INPUT_LENGTH=2000

