# ==============================================================================
# API GATEWAY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real secrets to version control.
# - Local development uses localhost URLs.
# - Docker Compose uses container service names.
# - Cloud deployment (e.g. Render) uses public/internal cloud service URLs.
# ==============================================================================

# Gateway Listening Port (Cloud platforms like Render dynamically provide PORT)
PORT=3000

# CORS Allowed Origin(s) - Comma-separated list or * for all
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# SERVICE DISCOVERY / UPSTREAM SERVICE REGISTRY
# ------------------------------------------------------------------------------

# Option A: Local Development (running directly on host machine)
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# Option B: Docker Compose (internal network service names)
# USER_SERVICE_URL=http://user-service:3001
# PRODUCT_SERVICE_URL=http://product-service:3002
# ORDER_SERVICE_URL=http://order-service:3003

# Option C: Cloud Deployment (e.g., Render / PaaS deployed service URLs)
# USER_SERVICE_URL=https://YOUR-USER-SERVICE.onrender.com
# PRODUCT_SERVICE_URL=https://YOUR-PRODUCT-SERVICE.onrender.com
# ORDER_SERVICE_URL=https://YOUR-ORDER-SERVICE.onrender.com
