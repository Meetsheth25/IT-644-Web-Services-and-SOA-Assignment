apiVersion: v1
kind: Secret
metadata:
  name: campusconnect-secrets
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campusconnect
type: Opaque
stringData:
  # Sensitive MongoDB Atlas connection strings & AI provider keys.
  # DO NOT commit real passwords or API keys into Git.
  #
  # Option 1: Create secret directly via CLI (Recommended):
  #   kubectl create secret generic campusconnect-secrets -n lab8 \
  #     --from-literal=USER_MONGODB_URI="mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/user_db?retryWrites=true&w=majority" \
  #     --from-literal=PRODUCT_MONGODB_URI="mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/product_db?retryWrites=true&w=majority" \
  #     --from-literal=ORDER_MONGODB_URI="mongodb+srv://<USER>:<PASS>@<CLUSTER>.mongodb.net/order_db?retryWrites=true&w=majority" \
  #     --from-literal=AI_API_KEY="<YOUR_GEMINI_API_KEY>"
  #
  # Option 2: Copy this file to k8s/secret.yaml (which is .gitignored), fill credentials, and apply individually:
  #   cp k8s/secret.yaml.example k8s/secret.yaml
  #   kubectl apply -f k8s/secret.yaml -n lab8
  USER_MONGODB_URI: "mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/user_db?retryWrites=true&w=majority"
  PRODUCT_MONGODB_URI: "mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/product_db?retryWrites=true&w=majority"
  ORDER_MONGODB_URI: "mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/order_db?retryWrites=true&w=majority"
  AI_API_KEY: "<YOUR_GEMINI_API_KEY>"
