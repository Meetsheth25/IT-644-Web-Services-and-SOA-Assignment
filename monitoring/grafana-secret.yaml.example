apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-secret
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campusconnect-monitoring
type: Opaque
stringData:
  # Sensitive Grafana Administrator Credentials.
  # DO NOT commit real passwords into Git.
  #
  # Option 1: Create secret directly via CLI (Recommended):
  #   kubectl create secret generic grafana-admin-secret -n lab8 \
  #     --from-literal=admin-user="admin" \
  #     --from-literal=admin-password="<STRONG_PASSWORD>"
  #
  # Option 2: Copy this file to monitoring/grafana-secret.yaml (which is .gitignored):
  #   cp monitoring/grafana-secret.yaml.example monitoring/grafana-secret.yaml
  #   kubectl apply -f monitoring/grafana-secret.yaml -n lab8
  admin-user: "admin"
  admin-password: "<STRONG_PASSWORD>"
