# ==============================================================================
# ORDER SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real passwords or connection strings to version control.
# - Cloud platforms (e.g., Render) inject PORT dynamically.
# ==============================================================================

# Server Port (Default: 3003)
PORT=3003
ORDER_SERVICE_PORT=3003

# CORS Allowed Origin(s)
CORS_ORIGIN=*

# MongoDB Connection String
# Local MongoDB Docker Container:
MONGODB_URI=mongodb://localhost:27017/order_db

# MongoDB Atlas (Cloud) Template:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/order_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# INTER-SERVICE REST COMMUNICATION URLS
# ------------------------------------------------------------------------------

# Option A: Local Development (running directly on host machine)
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002

# Option B: Docker Compose (internal network service names)
# USER_SERVICE_URL=http://user-service:3001
# PRODUCT_SERVICE_URL=http://product-service:3002

# Option C: Cloud Deployment (e.g., Render / PaaS deployed service URLs)
# USER_SERVICE_URL=https://YOUR-USER-SERVICE.onrender.com
# PRODUCT_SERVICE_URL=https://YOUR-PRODUCT-SERVICE.onrender.com
