# ==============================================================================
# PRODUCT SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real passwords or connection strings to version control.
# - Cloud platforms (e.g., Render) inject PORT dynamically.
# ==============================================================================

# Server Port (Default: 3002)
PORT=3002
PRODUCT_SERVICE_PORT=3002

# CORS Allowed Origin(s)
CORS_ORIGIN=*

# MongoDB Connection String
# Local MongoDB Docker Container:
MONGODB_URI=mongodb://localhost:27017/product_db

# MongoDB Atlas (Cloud) Template:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/product_db?retryWrites=true&w=majority
